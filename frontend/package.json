{
  "name": "opengym-frontend",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../scripts/catalogue/stage-media.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:watch": "tsc -p tsconfig.app.json --noEmit --watch",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "test:fatigue-probe": "node scripts/fatigue-monotonic-probe.mjs",
    "pdf:check": "node scripts/pdf/render-samples.mjs --out pdf-samples --langs en,de,ar --paper A4,Letter --check"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/openai": "^4.0.109",
    "ai": "^7.0.163",
    "i18next": "^26.7.1",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lean-qr": "^2.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.6",
    "lightningcss": "^1.33.0",
    "linkedom": "^0.18.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
